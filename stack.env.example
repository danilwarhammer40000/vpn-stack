# Answers for:  sudo ./install.sh --answers stack.env
# Shell syntax, no spaces around "=". Keep this file private (chmod 600): it holds the bot token.

BOT_TOKEN=
ADMIN_ID=

# Goes STRAIGHT to this server (A record -> server IP). Must NOT be behind the CDN:
# Let's Encrypt validates it over port 80 and TrustTunnel listens on 443 itself.
TT_DOMAIN=vpn.example.com

# Goes THROUGH the CDN (origin = this server, HTTP port 80, cache off).
XRAY_DOMAIN=xhtt.ru
# The CDN edge IP clients connect to (clients put it in the link, so they never need DNS first).
XRAY_EDGE_ADDR=

# Optional
ACME_EMAIL=
GEMINI_API_KEY=
LOG_CHANNEL_ID=
GEMINI_PROXY_URL=

# Optional overrides
#XRAY_VERSION=v26.6.27
#TT_VERSION=
#XRAY_PATH=/api/v1/sync
#PANEL_REPO=https://github.com/danilwarhammer40000/tg-trust.git
